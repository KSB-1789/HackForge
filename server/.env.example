PORT=5000
NODE_ENV=development

# ---------------------------------------------------------------------------
# Copy this file to server/.env and fill in the blanks. server/.env is
# gitignored, so every teammate needs their own.
#
# There is no database connection string here. CA2 storage is in-memory
# (server/data/store.js), so there is nothing to configure and nothing to
# provision. Data resets on every restart -- that is expected at this stage.
# ---------------------------------------------------------------------------
# Get the value from Atlas: Deployment -> Connect -> Drivers -> Node.js.
#
# TWO THINGS THAT BITE PEOPLE, both of which fail with a misleading error:
#
# 1. authSource=admin is required. A user created from Atlas's Database Access
#    page without a target database lives in admin. Leave it out and the driver
#    infers the auth source from the database named in the path, then fails with
#    "bad auth : Authentication failed" even when the password is correct.
#
# 2. If your password contains any of  / : " \ $ * < > + ,  it must be
#    URL-encoded in the URI or the URI will not parse.
#
# Atlas hands you an mongodb+srv:// string. That form depends on a DNS SRV
# lookup to discover the shards, and some resolvers answer that with REFUSED,
# which surfaces as "querySrv ECONNREFUSED" before any socket is opened. If you
# see that, list the shard hosts explicitly instead -- see D-029.
# ---------------------------------------------------------------------------
MONGO_URI=

# Generate your own: openssl rand -base64 48
# Share it with the team through a private channel, never through the repo.
JWT_SECRET=
JWT_EXPIRES_IN=7d

CLIENT_ORIGIN=http://localhost:5173
