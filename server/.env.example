PORT=5000
NODE_ENV=development
MONGODB_URI=

# ---------------------------------------------------------------------------
# Copy this file to server/.env and fill in the blanks. server/.env is
# gitignored, so every teammate needs their own.
#
# Set a local MongoDB URI or a private Atlas URI. Never commit credentials.
# ---------------------------------------------------------------------------

# Generate your own: openssl rand -base64 48
# Share it with the team through a private channel, never through the repo.
JWT_SECRET=
JWT_EXPIRES_IN=7d

CLIENT_ORIGIN=http://localhost:5173
